# Lekha — environment
#
# Copy to .env.local for development, or set these in your host's
# environment for a deployment. Nothing here has a safe default that
# suits production, so set all of them explicitly.

# The PostgreSQL database. Required — there is no local fallback,
# because pushing a schema at whatever database happens to be default
# is how the wrong one gets altered.
#   Render:  postgresql://USER:PASSWORD@HOST/DBNAME
# Use the External Database URL when connecting from outside Render,
# which includes a Vercel deployment.
DATABASE_URL=

# Where uploaded documents (PAN cards, cheques, investment proofs) are
# stored. One of the two below is required in production: without either,
# the app would fall back to a local filesystem that does not survive a
# deploy, so it refuses the upload instead.
#
# Nothing is readable by URL under either driver. Every read goes back
# through an authorised route that logs the access, because a link that
# opens a PAN card is a bearer token.

# Option 1 — any S3-compatible bucket. Cloudflare R2, Backblaze B2, AWS S3
# and MinIO all work; only the endpoint differs. Checked first, so setting
# these moves documents here.
#   R2:  https://<account-id>.r2.cloudflarestorage.com
#   B2:  https://s3.<region>.backblazeb2.com
#   AWS: leave S3_ENDPOINT unset and set S3_REGION instead
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# Optional folder inside the bucket, when it is shared with something else.
S3_PREFIX=

# Option 2 — Vercel Blob. Written by connecting a Blob store to the
# project; never set by hand.
BLOB_READ_WRITE_TOKEN=

# Development only. Used when neither of the above is set.
UPLOAD_ROOT=data/uploads

# Set by the host. Cookies are marked Secure only when this is
# "production", so a deployment that leaves it unset serves session
# cookies over plain HTTP.
NODE_ENV=production

# Self-serve registration at /signup. Open unless set to false — close it
# on an install serving a single company, where a public page that
# creates administrators is a liability rather than a feature.
SIGNUP_ENABLED=true

# ---- Outbound email ----
# Optional. Without it, invitations are still created and the link is shown
# on screen for somebody to pass on; with it, they are sent. One HTTPS call,
# no SDK — set both or neither.
# RESEND_API_KEY=
# MAIL_FROM="Lekha <payroll@yourcompany.com>"

# Where this deployment is reachable, for links that leave it (invitations).
# Read from the request when unset, which is right on Vercel and wrong behind
# an untrusted proxy — set it explicitly there.
# APP_ORIGIN=https://your-app.vercel.app
