# Lekha — environment
#
# Copy to .env.local for development, or set these in your host's
# environment for a deployment. Nothing here has a safe default that
# suits production, so set all of them explicitly.

# The hosted database. Required in production: a serverless deployment
# has no durable filesystem, so a file-backed database is lost on the
# next deploy. The app refuses to start in production without it.
#   Turso:  libsql://<name>-<org>.turso.io
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Development only. Used when DATABASE_URL is unset; the same libSQL
# client opens it as a plain local file.
DATABASE_PATH=data/lekha.db

# Vercel Blob, where uploaded documents (PAN cards, cheques, investment
# proofs) are stored. Required in production: without it the app would
# fall back to a local filesystem that does not survive a deploy, so it
# refuses to start instead. Vercel sets this for you when you connect a
# Blob store to the project.
# Blobs are written private — they are not readable by URL, and every
# read goes back through an authorised route that logs the access.
BLOB_READ_WRITE_TOKEN=

# Development only. Used when BLOB_READ_WRITE_TOKEN is unset.
UPLOAD_ROOT=data/uploads

# Set by the host. Cookies are marked Secure only when this is
# "production", so a deployment that leaves it unset serves session
# cookies over plain HTTP.
NODE_ENV=production

# Self-serve registration at /signup. Open unless set to false — close it
# on an install serving a single company, where a public page that
# creates administrators is a liability rather than a feature.
SIGNUP_ENABLED=true
